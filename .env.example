# ---- Database -------------------------------------------------------------
POSTGRES_USER=atlas
# Use letters and numbers only (it is embedded in a connection URL).
# Generate one:  openssl rand -hex 16
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atlas

# ---- Auth -----------------------------------------------------------------
# Secret shared with the browser extension. Generate:  openssl rand -hex 32
ATLAS_API_KEY=replace-with-generated-key
# Password you type on the dashboard login screen. Leave empty to use ATLAS_API_KEY.
DASHBOARD_PASSWORD=

# ---- Telegram (optional) --------------------------------------------------
# Token from @BotFather. Leave empty to disable notifications.
TELEGRAM_BOT_TOKEN=
# Random string Telegram echoes back so the backend knows a request really came from it.
# Generate:  openssl rand -hex 24   (letters, numbers, _ and - only)
TELEGRAM_WEBHOOK_SECRET=

# ---- Ports / frontend (optional) ------------------------------------------
USAGEOS_PORT=3000
VITE_API_URL=/api

# ---- Only for running the backend OUTSIDE Docker (see README-dev.md) -------
# DATABASE_URL=postgresql://atlas:change-me@localhost:5432/atlas
